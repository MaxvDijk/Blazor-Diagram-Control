@page "/"
@using BlazorDiagramControl.Components.Behavior
@using BlazorDiagramControl.Components.Classes
@using BlazorDiagramControl.Components.Controller
@using System.Text.Json
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject HttpClient Http
@inject MaxBehavior maxBehavior



<PageTitle>Diagrams</PageTitle>

<div class="container-fluid p-0">
    <div id="toolbar" class="d-flex flex-nowrap gap-2 p-2 mb-2 w-100 bg-secondary border rounded">
        <div class="dropdown">
          <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            Diagrams
          </button>
            <ul class="dropdown-menu gap-2">
                @foreach (var d in Diagrams)
                {
                    <li>
                        <button class="dropdown-item" @onclick="() => LoadDiagram(d.File)">
                            @d.Name
                        </button>
                    </li>
                }
            </ul>
        </div>
        <div class="">
            <button class="btn btn-success" @onclick="@(() => SaveDiagram())">
                Save
            </button>
        </div>
        <div class="d-flex gap-2">
            @foreach (string tool in Tools)
            {
                <button class="btn btn-primary gap-2" @onclick="@(() => SetTool(tool))">
                @tool
                </button>
            }
        </div>
        <div class="d-flex gap-2">
            @foreach (DiagramTemplate itemTemplate in ItemTemplates)
            {
                <div draggable="true" @ondrag="@((test) => Console.WriteLine("DRAGGING"))" @ondragend=" (e) => DragEnd(e, itemTemplate.Description)">
                    <button class="btn btn-primary gap-2" @onclick="@(() => SetTemplate(itemTemplate.Description))">
                        @itemTemplate.Description
                    </button>
                </div>
     
            }
        </div>
    </div>
    <div class="border dropzone">
        <div id="diagram-viewport" class="diagram-viewport ">
            <svg id="diagram-svg" class="diagram-svg ">
                <g id="all-objects">
                    <g id="lines-layer"></g>
                    <g id="shapes-layer"></g>
                </g>
            </svg>
        </div>
    </div>
</div>


@code {
    private string? _activeTool;

    private object DraggedItem;

    private DiagramBehavior? behavior;


    private IJSObjectReference? initDiagramModule;
    private IJSObjectReference? saveDiagramModule;
    IJSObjectReference generateModule;

    private List<DiagramItem> Diagrams = new();
    public string[] Tools = {"none", "line", "remove" };
    public List<DiagramTemplate> ItemTemplates = new List<DiagramTemplate>();

    private double[] Position;

    public class DiagramItem
    {
        public string Name { get; set; } = "";
        public string File { get; set; } = "";
    }
    private async Task DragEnd(DragEventArgs e,string type)
    {

        Position = [e.ClientX, e.ClientY];
        await SetTemplate(type);
    }


    private async Task SetTemplate(string type)
    {
        foreach (DiagramTemplate template in ItemTemplates)
        {
            if (template.Description == type && template.CanApply())
            {
                template.Apply();
            }
        }
    }
    private async Task GetTemplates()
    {
        maxBehavior.InitializeTemplates();
        ItemTemplates = maxBehavior.Templates;
    }

    protected override async Task OnInitializedAsync()
    {
        await GetTemplates();
        var result = await Http.GetFromJsonAsync<List<DiagramItem>>("Diagrams/Diagrams.json");
        Diagrams = result ?? new();

        maxBehavior.Items.CollectionChanged += ItemsChanged;
        maxBehavior.Connections.CollectionChanged += ConnectionsChanged;
    }
    public async void ItemsChanged(object? sender, System.Collections.Specialized.NotifyCollectionChangedEventArgs e)
    {
        foreach (object model in e.NewItems)
        {
            var itemDef = maxBehavior.ItemDefinitionForItem(model);
            Console.WriteLine(JsonSerializer.Serialize(itemDef));
            generateModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/Javascript/Services/GenerateShape.js");

            await generateModule.InvokeVoidAsync("generateShape", itemDef, Position);

        }
    }

    private void ConnectionsChanged(object? sender, System.Collections.Specialized.NotifyCollectionChangedEventArgs e)
    {
        
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            // IJSObjectReference interactionModule = await JS.InvokeAsync<IJSObjectReference>(
            //     "import", "/Javascript/Interaction/InteractionHandler.js");

            // await interactionModule.InvokeVoidAsync("initInteraction");
        }
    }

    private async Task LoadDiagram(string file)
    {
        if (initDiagramModule is null)
        {
            initDiagramModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/Javascript/Services/initDiagram.js");

        }

        await initDiagramModule.InvokeVoidAsync("initDiagram", file);
    }

    private async Task SetTool(string tool)
    {

        _activeTool = tool;

        var toolbarModule = await JS.InvokeAsync<IJSObjectReference>(
            "import", "/Javascript/Interaction/ToolBarButtonController.js");

        await toolbarModule.InvokeVoidAsync("setActiveTool", tool);
    }
    private async Task SaveDiagram()
    {
        saveDiagramModule = await JS.InvokeAsync<IJSObjectReference>(
            "import", "/Javascript/Interaction/SaveDiagramButton.js");

        await saveDiagramModule.InvokeVoidAsync("saveDiagram");
    }
    // public void Dispose()
    // {
    //     objRef?.Dispose();
    // }
}