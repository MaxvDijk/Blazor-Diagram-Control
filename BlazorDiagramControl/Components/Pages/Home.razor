@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>Diagrams</PageTitle>

<h1>Diagrams</h1>

@if (Diagrams.Count == 0)
{
    <p>Loading...</p>
}

@foreach (var d in Diagrams)
{
    <button @onclick="() => LoadDiagram(d.File)">
        @d.Name
    </button>
}

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <p>@StatusMessage</p>
}

<div id="diagram-viewport" class="diagram-viewport">
    <svg id="diagram-svg" class="diagram-svg">
        <g id="world">
            <g id="lines-layer"></g>
            <g id="shapes-layer"></g>
        </g>
    </svg>
</div>

@code {

    private List<DiagramItem> Diagrams = new();
    private string? StatusMessage;
    private IJSObjectReference? _module;

    public class DiagramItem
    {
        public string Name { get; set; } = "";
        public string File { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await Http.GetFromJsonAsync<List<DiagramItem>>("Diagrams/Diagrams.json");
        Diagrams = result ?? new();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "/Javascript/Services/initDiagram.js");
    }

    private async Task LoadDiagram(string file)
    {
        try
        {
            StatusMessage = $"Loading {file}";
            StateHasChanged();

            if (_module is null)
                return;

            await _module.InvokeVoidAsync("initDiagram", file);

            StatusMessage = $"Loaded {file}";
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }

        StateHasChanged();
    }
}