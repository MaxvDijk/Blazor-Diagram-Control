@using BlazorDiagramControl.Components.Behavior
@using BlazorDiagramControl.Components.Classes
@using Newtonsoft.Json
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>Diagrams</PageTitle>

<div class="container-fluid p-0">
    <div id="toolbar" class="d-flex flex-nowrap gap-2 p-2 mb-2 w-100 bg-secondary border rounded">
        <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Diagrams
            </button>
            <ul class="dropdown-menu gap-2">
                @foreach (var d in Diagrams)
                {
                    <li>
                        <button class="dropdown-item" @onclick="() => LoadDiagram(d.File)">
                            @d.Name
                        </button>
                    </li>
                }
            </ul>
        </div>
        <div class="">
            <button class="btn btn-success" @onclick="@(() => SaveDiagram())">
                Save
            </button>
        </div>
        <div class="d-flex gap-2">
                <button class="btn btn-primary gap-2" @onclick="@(() => DeleteObject())">
                    Remove
                </button>
        </div>
        <div class="d-flex gap-2 ms-5">
            @foreach (DiagramTemplate itemTemplate in ItemTemplates)
            {

                <div draggable="true" @ondragend="@((e) => DragEnd(e, itemTemplate.Description))"> 
                    <button class="btn btn-primary gap-2" @onclick="@(() => SetTemplate(itemTemplate.Description))">
                        @itemTemplate.Description
                    </button>
                </div>
     
            }
        </div>
    </div>
    <div class="border dropzone">
        <div id="diagram-viewport" class="diagram-viewport ">
            <svg id="diagram-svg" class="diagram-svg ">
                <g id="all-objects">
                    <g id="lines-layer"></g>
                    <g id="shapes-layer"></g>
                </g>
            </svg>
        </div>
    </div>
</div>

<DetailScreenComponent DTO="DTO" />
@code {
    [Parameter]
    public DiagramBehavior diagramBehavior { get; set; }

    private object DTO;
    private string? _activeTool;

    private DotNetObjectReference<DiagramComponent>? dotNetHelper;

    private IJSObjectReference? initDiagramModule;
    private IJSObjectReference? saveDiagramModule;
    private IJSObjectReference generateModule;

    private List<DiagramItem> Diagrams = new();
    public List<DiagramTemplate> ItemTemplates = new List<DiagramTemplate>();

    public string selectedShape;


    private double x, y;

    public class DiagramItem
    {
        public string Name { get; set; } = "";
        public string File { get; set; } = "";
    }


    private async Task DragEnd(DragEventArgs e, string type)
    {
        x = e.ClientX;
        y = e.ClientY;

        DTO = new object();
        await SetTemplate(type);
    }


    private async Task SetTemplate(string type)
    {
        foreach (DiagramTemplate template in ItemTemplates)
        {
            if (template.Description == type && template.CanApply())
            {
                template.Apply();
            }
        }
    }
    private async Task GetTemplates()
    {
        diagramBehavior.InitializeTemplates();
        ItemTemplates = diagramBehavior.Templates;
    }

    protected override async Task OnInitializedAsync()
    {
        await GetTemplates();
        var result = await Http.GetFromJsonAsync<List<DiagramItem>>("Diagrams/Diagrams.json");
        Diagrams = result ?? new();

        diagramBehavior.Items.CollectionChanged += ItemsChanged;
        diagramBehavior.Connections.CollectionChanged += ConnectionsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetHelper = DotNetObjectReference.Create(this);
        }
    }


    public async void ItemsChanged(object? sender, System.Collections.Specialized.NotifyCollectionChangedEventArgs e)
    {
        if (e.NewItems == null)
        {
            return;
        }
        foreach (object model in e.NewItems)
        {
            var id = diagramBehavior.IdForItemObject(model);
            var itemDef = diagramBehavior.ItemDefinitionForItem(model);
            generateModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/Javascript/Services/Builder.js");

            var JsonString = JsonConvert.SerializeObject(itemDef);
            await generateModule.InvokeVoidAsync("shapeBuilder", JsonString, x, y, id);
            x = y = 0;
        }
    }

    private async void ConnectionsChanged(object? sender, System.Collections.Specialized.NotifyCollectionChangedEventArgs e)
    {
        foreach (DiagramConnection model in e.NewItems)
        {
            var id = diagramBehavior.IdForConnectionObject(model.Context);
            var connectionDef = diagramBehavior.ConnectionDefinitionForConnection(model);
            generateModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/Javascript/Services/Builder.js");

            var JsonString = JsonConvert.SerializeObject(connectionDef);
            await generateModule.InvokeVoidAsync("lineBuilder", JsonString, id);

        }
    }

    private async Task LoadDiagram(string file)
    {
        if (initDiagramModule is null)
        {
            initDiagramModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/Javascript/Services/initializer.js");

        }

        await initDiagramModule.InvokeVoidAsync("initDiagram", file, dotNetHelper);
    }

    private async Task SaveDiagram()
    {
        saveDiagramModule = await JS.InvokeAsync<IJSObjectReference>(
            "import", "/Javascript/Interaction/SaveDiagramButton.js");

        await saveDiagramModule.InvokeVoidAsync("saveDiagram");
    }
    private async Task DeleteObject()
    {
        List<string> shapes = new List<string>();
        if(selectedShape != null)
        {
            shapes.Add(selectedShape);
            await RemoveItem(shapes);
            shapes.Clear();
            selectedShape = null;
        }
    }
    [JSInvokable]
    public async Task SetSelectedItem(string csObjectID)
    {
        selectedShape = csObjectID;
    }
    [JSInvokable]
    public async Task AddLine(string sourceID, string targetID)
    {
        object source = diagramBehavior.ItemObjectForId(sourceID);
        object target = diagramBehavior.ItemObjectForId(targetID);
        bool canAddLine = diagramBehavior.CanConnect(source, target);
        if (canAddLine)
        {
            diagramBehavior.Connect(source, target);
        }

    }
    [JSInvokable]
    public async Task RemoveItem(List<string> csObjects)
    {
        List<object> tempList = new List<object>();
        foreach (string csObject in csObjects)
        {
            tempList.Add(diagramBehavior.AnyObjectForId(csObject));
        }

        bool canRemove = diagramBehavior.CanDeleteItems(tempList);
        if (canRemove)
        {
            diagramBehavior.DeleteItems(tempList);

            var removeItemModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/Javascript/Services/Remover.js");

            await removeItemModule.InvokeVoidAsync("removeObject", csObjects);

            
        }
        tempList.Clear();
    }


    public void Dispose()
    {
        dotNetHelper?.Dispose();
    }
}